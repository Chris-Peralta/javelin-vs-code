{
  "name": "javelin-vs-code",
  "displayName": "Javelin Paper Tape",
  "description": "Live paper tape viewer for Javelin steno keyboards",
  "version": "0.0.1",
  "private": true,
  "publisher": "javelin-vs-code",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:javelin.showPaperTape"
  ],
  "contributes": {
    "commands": [
      {
        "command": "javelin.showPaperTape",
        "title": "Javelin: Show Paper Tape",
        "category": "Javelin"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "javelin",
          "title": "Javelin",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "javelin": [
        {
          "id": "javelin.statusView",
          "name": "Status",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "js-yaml": "^5.2.2",
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.85.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
